{
    "name": "dynart/dpress-test",
    "description": "Test suite for dpress.",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Dynart\\Dpress\\Test\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Dynart\\Dpress\\Test\\Unit\\": "tests/Unit/"
        }
    },
    "minimum-stability": "dev",
    "require": {
        "php": ">=8.0",
        "dynart/dpress": "@dev"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5"
    },
    "repositories": {
        "dynart-dpress": {
            "type": "path",
            "url": "../dynart-dpress",
            "options": {
                "symlink": true
            }
        },
        "dynart-micro": {
            "type": "path",
            "url": "../dynart-micro",
            "options": {
                "symlink": true
            }
        },
        "dynart-micro-entities": {
            "type": "path",
            "url": "../dynart-micro-entities",
            "options": {
                "symlink": true
            }
        }
    }
}
